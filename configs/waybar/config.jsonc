{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["tray"],
    "modules-right": ["cpu", "memory", "pulseaudio", "clock"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },
    "clock": {
        "format": "{:%H:%M  %d.%m}",
        "tooltip-format": "{:%A, %B %d, %Y}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": ["", "", ""],
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " {ifname}",
        "format-disconnected": "⚠"
    },
    "tray": {
        "spacing": 10
    },
    "cpu": {
    "interval": 5,
    "format": "CPU {usage}%"
    },
    "memory": {
      "interval": 5,
      "format": "RAM {percentage}%"
    }
}
