# Показывать иконки приложений
allow_images=true
# Игнорировать регистр при поиске
insensitive=true
# Скрыть уродливый скроллбар
hide_scroll=true
# Ширина окна (25% от экрана)
width=25%
# Количество строк в списке
lines=10
# Расположение: по центру
location=center
# Не использовать дефолтную тему GTK, чтобы наша CSS работала
gtk_dark=true
